# Maintainer: Tim Palpant <tim@palpant.us>
pkgname=kvault
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial native Kirigami client for Bitwarden servers"
arch=('x86_64' 'aarch64')
url="https://github.com/timpalpant/kvault"
license=('GPL-3.0-or-later')
depends=(
  'argon2'
  'kcoreaddons'
  'kdbusaddons'
  'ki18n'
  'kirigami'
  'kirigami-addons'
  'kstatusnotifieritem'
  'openssl'
  'qqc2-desktop-style'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qtkeychain-qt6'
)
makedepends=('cmake' 'ninja')
checkdepends=()
# The release asset built by .github/workflows/release.yml, not the archive
# GitHub generates on demand: the uploaded file is immutable and its digest is
# published alongside it, so there is a fixed value to check against.
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
# Never SKIP here. This is a fixed tarball, not a VCS checkout, so SKIP would
# mean makepkg builds whatever the download happened to return. Take the value
# from kvault-$pkgver.tar.gz.sha256 in the release; the release workflow prints
# the line to paste. An unreplaced placeholder fails the build, which is the
# point -- a wrong hash must stop the build, not be waved through.
sha256sums=('REPLACE_WITH_RELEASE_SHA256')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  # apitest binds a localhost socket, which some build environments disallow.
  ctest --test-dir build --output-on-failure --no-tests=error -E apitest
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
